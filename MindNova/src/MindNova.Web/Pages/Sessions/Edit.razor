@page "/sessions/{Id:guid}/edit"
@attribute [Authorize]
@inject SessionApiService SessionApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="mb-4">Edit Session</MudText>

@if (_loadError != null)
{
    <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
}
else if (_model == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudCard>
        <MudCardContent>
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
            }
            <MudForm @ref="_form" @bind-IsValid="_formValid">
                <MudGrid>
                    <MudItem xs="6">
                        <MudDatePicker @bind-Date="_scheduledDate" Label="Date"
                                       Required="true" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudTimePicker @bind-Time="_scheduledTime" Label="Time"
                                       Required="true" />
                    </MudItem>
                    <MudItem xs="4">
                        <MudNumericField @bind-Value="_model.DurationMinutes" Label="Duration (minutes)"
                                         Min="1" Required="true" />
                    </MudItem>
                    <MudItem xs="4">
                        <MudSelect @bind-Value="_model.SessionType" Label="Session Type" Required="true">
                            <MudSelectItem Value="@("Individual")">Individual</MudSelectItem>
                            <MudSelectItem Value="@("Group")">Group</MudSelectItem>
                            <MudSelectItem Value="@("Intake")">Intake</MudSelectItem>
                            <MudSelectItem Value="@("FollowUp")">Follow Up</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="4">
                        <MudSelect @bind-Value="_model.Status" Label="Status" Required="true">
                            <MudSelectItem Value="@("Scheduled")">Scheduled</MudSelectItem>
                            <MudSelectItem Value="@("Completed")">Completed</MudSelectItem>
                            <MudSelectItem Value="@("Cancelled")">Cancelled</MudSelectItem>
                            <MudSelectItem Value="@("NoShow")">No Show</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.Notes" Label="Notes" Lines="3" />
                    </MudItem>
                </MudGrid>
            </MudForm>
        </MudCardContent>
        <MudCardActions>
            <MudButton OnClick="@(() => Navigation.NavigateTo("/sessions"))">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@HandleSubmit"
                       Disabled="@(!_formValid || _saving)">
                @if (_saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                Save
            </MudButton>
        </MudCardActions>
    </MudCard>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private MudForm _form;
    private UpdateSessionModel _model;
    private DateTime? _scheduledDate;
    private TimeSpan? _scheduledTime;
    private bool _formValid;
    private bool _saving;
    private string _error = string.Empty;
    private string _loadError;

    protected override async Task OnInitializedAsync()
    {
        var session = await SessionApi.GetSessionAsync(Id);
        if (session == null)
        {
            _loadError = "Session not found.";
            return;
        }

        _scheduledDate = session.ScheduledAt.Date;
        _scheduledTime = session.ScheduledAt.TimeOfDay;
        _model = new UpdateSessionModel
        {
            ScheduledAt = session.ScheduledAt,
            DurationMinutes = session.DurationMinutes,
            SessionType = session.SessionType,
            Status = session.Status,
            Notes = session.Notes
        };
    }

    private async Task HandleSubmit()
    {
        await _form.Validate();
        if (!_formValid) return;

        _model.ScheduledAt = _scheduledDate?.Date.Add(_scheduledTime ?? TimeSpan.Zero) ?? _model.ScheduledAt;

        _saving = true;
        _error = string.Empty;

        var (session, error) = await SessionApi.UpdateSessionAsync(Id, _model);

        if (error != null)
        {
            _error = error;
            _saving = false;
            return;
        }

        Snackbar.Add("Session updated successfully", Severity.Success);
        Navigation.NavigateTo("/sessions");
    }
}
