@page "/sessions/{SessionId:guid}/notes/create"
@attribute [Authorize(Roles = "Admin,Therapist")]
@inject NoteApiService NoteApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="mb-4">Create Note</MudText>

@if (_accessDenied)
{
    <MudAlert Severity="Severity.Warning">You are not authorised to create notes for this session.</MudAlert>
}
else
{
    <MudCard>
        <MudCardContent>
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
            }
            <MudForm @ref="_form" @bind-IsValid="_formValid">
                <MudGrid>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.PresentingIssue" Label="Presenting Issue"
                                      Lines="3" Required="true" RequiredError="Presenting issue is required" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.Interventions" Label="Interventions" Lines="3" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.Homework" Label="Homework" Lines="2" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-1">Progress Rating: @_model.ProgressRating</MudText>
                        <MudSlider @bind-Value="_model.ProgressRating" Min="1" Max="10" Step="1"
                                   Color="Color.Primary" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.FreeText" Label="Free Text" Lines="4" />
                    </MudItem>
                </MudGrid>
            </MudForm>
        </MudCardContent>
        <MudCardActions>
            <MudButton OnClick="@(() => Navigation.NavigateTo($"/sessions/{SessionId}/notes"))">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@HandleSubmit"
                       Disabled="@(!_formValid || _saving)">
                @if (_saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                Save
            </MudButton>
        </MudCardActions>
    </MudCard>
}

@code {
    [Parameter] public Guid SessionId { get; set; }

    private MudForm _form;
    private CreateNoteModel _model = new();
    private bool _formValid;
    private bool _saving;
    private string _error = string.Empty;
    private bool _accessDenied;

    private async Task HandleSubmit()
    {
        await _form.Validate();
        if (!_formValid) return;

        _saving = true;
        _error = string.Empty;

        var (note, error) = await NoteApi.CreateNoteAsync(SessionId, _model);

        if (error == "access-denied")
        {
            _accessDenied = true;
            _saving = false;
            return;
        }

        if (error != null)
        {
            _error = error;
            _saving = false;
            return;
        }

        Snackbar.Add("Note created successfully", Severity.Success);
        Navigation.NavigateTo($"/sessions/{SessionId}/notes");
    }
}
